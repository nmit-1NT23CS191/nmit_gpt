# Copy to .env (dev) or .env.production (prod). Never commit the real file.

# --- App ---
ENVIRONMENT=development

# --- Supabase (cloud-hosted — create a project at supabase.com) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # backend only — never expose to frontend
SUPABASE_JWT_SECRET=your-project-jwt-secret           # Project Settings -> API -> JWT Settings
SUPABASE_STORAGE_BUCKET=event-docs

# --- Ollama (self-hosted, started by docker-compose.yml) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Voice (self-hosted, no keys needed — models baked into the backend image) ---
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
PIPER_MODEL_PATH=/models/piper/en_US-lessac-medium.onnx
PIPER_MODEL_CONFIG_PATH=/models/piper/en_US-lessac-medium.onnx.json

# --- Frontend (public — safe to expose to the browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Production only ---
REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
PUBLIC_API_URL=https://api.yourdomain.edu
